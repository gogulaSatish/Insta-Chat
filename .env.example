# MongoDB Connection URI
MONGO_DB_URI=mongodb+srv://username:password@cluster.mongodb.net/instachat?retryWrites=true&w=majority

# JWT Secret for token generation
JWT_SECRET=your_jwt_secret_key_here_min_32_chars

# Node Environment
NODE_ENV=development

# Server Port
PORT=5000

# Frontend URL (for local development)
FRONTEND_URL=http://localhost:3000

# Production URL (for Render deployment)
PRODUCTION_URL=https://your-app-name.onrender.com

# Render automatically provides RENDER_EXTERNAL_URL in production
# RENDER_EXTERNAL_URL is set by Render automatically
